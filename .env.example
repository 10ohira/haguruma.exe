# Override the pixel-code-web base URL the Electron client posts to.
# Defaults to https://pixel-code-web.vercel.app when unset (no need to
# create a .env at all for the default deployment).
PIXEL_WEB_URL=https://pixel-code-web.vercel.app

# Optional dev convenience: when set to "true" the renderer skips the
# pixel-code-web login form and goes straight into the cheat UI.
# Leave commented out for production / regular use.
# PIXEL_DEV_BYPASS_AUTH=true
